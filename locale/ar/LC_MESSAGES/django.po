msgstr "حق الاعتراض"

#: .\templates\core\legal\privacy.html:164
msgid "Droit à la limitation du traitement"
msgstr "حق تقييد المعالجة"

#: .\templates\core\legal\privacy.html:165
msgid "Droit à la portabilité"
msgstr "حق نقل البيانات"

#: .\templates\core\legal\privacy.html:166
msgid "Droit de retirer votre consentement à tout moment"
msgstr "حق سحب موافقتك في أي وقت"

#: .\templates\core\legal\privacy.html:168
