#: .\templates\core\legal\terms.html:158
msgid "En cas de litige, une solution amiable sera recherchée en priorité."
msgstr "في حالة وجود نزاع، سيتم السعي للتوصل إلى حل ودي كأولوية."

#: .\templates\core\legal\terms.html:166
msgid "Contact"
msgstr "جهة الاتصال"

#: .\templates\core\legal\terms.html:169
msgid ""
"Pour toute question concernant une commande, un paiement ou un "
